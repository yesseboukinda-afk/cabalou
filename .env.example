

# Application
# Generate a unique secret of at least 32 characters for each environment.
CABALOU_SESSION_SECRET=
CABALOU_BIND=127.0.0.1
# Defaults to data/cabalou_demo.sqlite3 when unset.
CABALOU_DB_PATH=

# Supabase Auth (required for sign-in and administrator creation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL (optional; unset uses local SQLite)
CABALOU_SUPABASE_DATABASE_URL=

# AI provider: openai (default) or groq
AI_PROVIDER=openai

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Groq free plan (optional alternative; quotas depend on account)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Search Console (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# Meta Facebook Page (optional)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Meta Ads (optional)
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# TikTok account (optional)
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# TikTok Ads (optional)
TIKTOK_ADVERTISER_ID=
TIKTOK_ADS_ACCESS_TOKEN=

# SMTP (optional)
CABALOU_SMTP_HOST=
CABALOU_SMTP_PORT=587
CABALOU_SMTP_USERNAME=
CABALOU_SMTP_PASSWORD=
CABALOU_SMTP_FROM=

# Cabalou listings API, read-only (optional)
CABALOU_LISTINGS_API_URL=
CABALOU_API_TOKEN=
